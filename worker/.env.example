# Supabase — the service-role key, not the anon key. The worker has no user
# session and video_queue's RLS only admits Jacob and Madi.
# Both values are already in Vercel: the URL is VITE_SUPABASE_URL, and the
# service key is stored there under supabase_service_role_secret.
SUPABASE_URL=https://cswhhnrhtetjxgqygdes.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The same keys entered in Plated's admin panel (tap the logo 5x). They now
# also live here, because the worker extracts without a browser involved.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cobalt, over the shared Docker network. Must match the key in ~/cobalt/keys.json.
COBALT_URL=http://cobalt:9000/
COBALT_API_KEY=

# Optional — the defaults are sensible.
# POLL_INTERVAL_MS=10000
# MAX_ATTEMPTS=2
# STALE_CLAIM_MS=900000
# WORKER_ID=homelab
